# ============================================================
# AI Listing Eligibility Checker — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ============================================================

# ── LLM Provider (used only for 2 calls: content-quality + citation-likelihood)
# Set exactly one. If neither is set, the tool runs in mock-fallback mode
# and clearly labels LLM scores as "unavailable".

# Option A: Groq (preferred — fast, generous free tier)
GROQ_API_KEY=

# Option B: Gemini free tier (fallback if Groq is unavailable)
GEMINI_API_KEY=

# Active provider: "groq" | "gemini" | "mock"
# If set to "mock" or if the chosen key is empty, LLM calls return a labeled fallback.
LLM_PROVIDER=groq

# Model to use for LLM calls
# Groq:   llama-3.3-70b-versatile  |  mixtral-8x7b-32768
# Gemini: gemini-1.5-flash-latest
LLM_MODEL=llama-3.3-70b-versatile

# ── Feature Flags
# Set to "true" to enable optional expensive features
ENABLE_PLAYWRIGHT=true          # headless rendering (escalated only — not on every request)
ENABLE_GEO_CHECK=true           # Cloudflare Worker geo trip-wire (Tier-2)
ENABLE_LLM=true                 # LLM-based quality/citation scoring

# ── Cloudflare Worker endpoints (Tier-2 geo trip-wire)
# Deploy workers/geo_fetch/ to Cloudflare free tier and paste the URLs here.
# Leave empty to skip geo checks gracefully.
GEO_WORKER_URL_US=
GEO_WORKER_URL_EU=
GEO_WORKER_URL_APAC=

# ── SQLite (history store)
# Relative or absolute path to the database file.
SQLITE_DB_PATH=data/history.db

# ── Server
HOST=0.0.0.0
PORT=8000
